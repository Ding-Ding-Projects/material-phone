{
  "schemaVersion": 1,
  "packageId": "MaterialPhone",
  "applicationExecutableRelativePath": "bin/MaterialPhone.exe",
  "requiredArtifacts": [
    "Setup.exe",
    "RELEASES",
    "*-full.nupkg",
    "payload-provenance.json"
  ],
  "optionalArtifacts": [
    "*-delta.nupkg"
  ],
  "signing": {
    "allowed": false,
    "requiredAuthenticodeStatus": "NotSigned",
    "verifyPayloadExecutables": true,
    "verifyPackageExecutables": true
  },
  "updates": {
    "transport": "https",
    "integrity": "RELEASES package hashes"
  }
}
